{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cinqic Notes",
  "version": "0.1.0",
  "identifier": "com.cinqic.notes",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cinqic Notes",
        "width": 1360,
        "height": 860,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Local-first notes in files you own.",
    "longDescription": "A calm, private notes application for ordinary Markdown and text files.",
    "publisher": "Cinqic",
    "targets": ["msi", "deb", "appimage"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "windows": {
      "wix": { "version": "0.1.0.0", "upgradeCode": "b51d1e38-8df6-4a5e-ae9b-8d2e5f2fb6a0" }
    }
  }
}
