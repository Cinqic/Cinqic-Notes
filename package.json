{
  "name": "cinqic-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first, user-owned notes app by Cinqic.",
  "license": "Apache-2.0",
  "author": "Cinqic",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "benchmark:fixtures": "node scripts/generate-benchmark-library.mjs",
    "schema:validate": "node scripts/validate-schemas.mjs",
    "license:inventory": "node scripts/license-inventory.mjs",
    "version:check": "node scripts/check-version.mjs",
    "validate": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --locked --manifest-path src-tauri/Cargo.toml && pnpm schema:validate && pnpm version:check"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "ajv": "8.17.1",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.3.5",
    "vitest": "3.2.6"
  }
}
